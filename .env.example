# Live Duffel search. Orders are never created from this app.
DUFFEL_ACCESS_TOKEN=

# Optional persistence. Without these, bookings are stored in .data/bookings.json
# when the server can write, and always copied into the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Staff desk. There is no default password.
ADMIN_PASSWORD=

# Set to true only when a real supplier order and payment flow is approved.
NEXT_PUBLIC_LIVE_BOOKING=
